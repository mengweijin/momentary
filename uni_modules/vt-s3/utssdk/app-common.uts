// Android / iOS / HarmonyOS shared S3 API implementation.

import { S3Config } from "./interface.uts"
import { getListQuery, signS3Request } from "./sigv4.uts"

let s3Config : S3Config | null = null

function requireValue(value : string, name : string) : void {
	if (value!.trim().length == 0) {
		throw new Error(`S3 ${name} must not be empty`)
	}
}

export function initS3(config : S3Config) : Promise<UTSJSONObject> {
	requireValue(config.endpoint!, "endpoint")
	requireValue(config.accessKey!, "accessKey")
	requireValue(config.secretKey!, "secretKey")
	requireValue(config.bucket!, "bucket")
	requireValue(config.region!, "region")

	s3Config = {
		endpoint: config.endpoint!,
		accessKey: config.accessKey!,
		secretKey: config.secretKey!,
		bucket: config.bucket!,
		region: config.region!,
		forcePathStyle: config.forcePathStyle
	}
	return createBucket()
}

export function bucketExists() : Promise<boolean> {
	const config = s3Config
	if (config == null) {
		return new Promise<boolean>((resolve : (value : boolean) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 is not initialized; call initS3 first"))
		})
	}

	return new Promise<boolean>((resolve : (value : boolean) => void, reject : (reason : any) => void) => {
		const signed = signS3Request(config, "HEAD", "", "")
		const headers : UTSJSONObject = {
			"Authorization": signed.authorization,
			"x-amz-content-sha256": signed.payloadHash,
			"x-amz-date": signed.date
		}
		uni.request({
			url: signed.url,
			method: "HEAD",
			header: headers,
			responseType: "text",
			success: (response : RequestSuccess<any>) => {
				if (response.statusCode >= 200 && response.statusCode < 300) {
					resolve(true)
				} else if (response.statusCode == 404) {
					resolve(false)
				} else {
					reject({
						statusCode: response.statusCode,
						data: response.data,
						header: response.header
					})
				}
			},
			fail: (error : RequestFail) => {
				reject(error)
			}
		})
	})
}

export function createBucket() : Promise<UTSJSONObject> {
	const config = s3Config
	if (config == null) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 is not initialized; call initS3 first"))
		})
	}

	return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
		bucketExists().then((exists : boolean) => {
			if (exists) {
				resolve({
					statusCode: 200,
					data: null,
					header: {}
				})
				return
			}

			const signed = signS3Request(config, "PUT", "", "")
			const headers : UTSJSONObject = {
				"Authorization": signed.authorization,
				"x-amz-content-sha256": signed.payloadHash,
				"x-amz-date": signed.date
			}
			uni.request({
				url: signed.url,
				method: "PUT",
				header: headers,
				responseType: "text",
				success: (response : RequestSuccess<any>) => {
					const result : UTSJSONObject = {
						statusCode: response.statusCode,
						data: response.data,
						header: response.header
					}
					if (response.statusCode >= 200 && response.statusCode < 300) {
						resolve(result)
					} else {
						reject(result)
					}
				},
				fail: (error : RequestFail) => {
					reject(error)
				}
			})
		}, (error : any) => {
			reject(error)
		})
	})
}

export function getObject(key : string) : Promise<UTSJSONObject> {
	const config = s3Config
	if (config == null) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 is not initialized; call initS3 first"))
		})
	}
	if (key!.trim().length == 0) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 key is required for getObject"))
		})
	}

	return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
		const signed = signS3Request(config, "GET", `/${key}`, "")
		const headers : UTSJSONObject = {
			"Authorization": signed.authorization,
			"x-amz-content-sha256": signed.payloadHash,
			"x-amz-date": signed.date
		}
		uni.request({
			url: signed.url,
			method: "GET",
			header: headers,
			responseType: "arraybuffer",
			success: (response : RequestSuccess<any>) => {
				const result : UTSJSONObject = {
					statusCode: response.statusCode,
					data: response.data,
					header: response.header
				}
				if (response.statusCode >= 200 && response.statusCode < 300) {
					resolve(result)
				} else {
					reject(result)
				}
			},
			fail: (error : RequestFail) => {
				reject(error)
			}
		})
	})
}

export function deleteObject(key : string) : Promise<UTSJSONObject> {
	const config = s3Config
	if (config == null) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 is not initialized; call initS3 first"))
		})
	}
	if (key!.trim().length == 0) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 key is required for deleteObject"))
		})
	}

	return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
		const signed = signS3Request(config, "DELETE", `/${key}`, "")
		const headers : UTSJSONObject = {
			"Authorization": signed.authorization,
			"x-amz-content-sha256": signed.payloadHash,
			"x-amz-date": signed.date
		}
		uni.request({
			url: signed.url,
			method: "DELETE",
			header: headers,
			responseType: "text",
			success: (response : RequestSuccess<any>) => {
				const result : UTSJSONObject = {
					statusCode: response.statusCode,
					data: response.data,
					header: response.header
				}
				if (response.statusCode >= 200 && response.statusCode < 300) {
					resolve(result)
				} else {
					reject(result)
				}
			},
			fail: (error : RequestFail) => {
				reject(error)
			}
		})
	})
}

export function listObjects(prefix : string | null) : Promise<UTSJSONObject> {
	const config = s3Config
	if (config == null) {
		return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
			reject(new Error("S3 is not initialized; call initS3 first"))
		})
	}

	return new Promise<UTSJSONObject>((resolve : (value : UTSJSONObject) => void, reject : (reason : any) => void) => {
		const signed = signS3Request(config, "GET", "", getListQuery(prefix))
		const headers : UTSJSONObject = {
			"Authorization": signed.authorization,
			"x-amz-content-sha256": signed.payloadHash,
			"x-amz-date": signed.date
		}
		uni.request({
			url: signed.url,
			method: "GET",
			header: headers,
			responseType: "text",
			success: (response : RequestSuccess<any>) => {
				const result : UTSJSONObject = {
					statusCode: response.statusCode,
					data: response.data,
					header: response.header
				}
				if (response.statusCode >= 200 && response.statusCode < 300) {
					resolve(result)
				} else {
					reject(result)
				}
			},
			fail: (error : RequestFail) => {
				reject(error)
			}
		})
	})
}
