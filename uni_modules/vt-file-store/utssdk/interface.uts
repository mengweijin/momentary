// utssdk/interface.uts
// 跨平台通用配置读写接口，不依赖任何业务数据结构

/**
 * 从指定文件加载内容
 * @param fileName 文件名，如 "user_config.json"
 * @returns 文件内容字符串；文件不存在或读取失败时返回 null
 */
export declare function load(fileName : string) : string | null

/**
 * 将内容保存到指定文件；文件不存在时自动创建
 * @param fileName 文件名，如 "user_config.json"
 * @param content  要写入的字符串内容
 */
export declare function save(fileName : string, content : string) : void

/**
 * 删除指定文件
 * @param fileName 文件名
 */
export declare function clear(fileName : string) : void

