// utssdk/app-common.uts
// Android / iOS / HarmonyOS 三端共享实现

import { DIR_NAME } from './const.uts'

function getDirPath() : string {
	return `${uni.env.USER_DATA_PATH}/${DIR_NAME}`
}

function getFilePath(fileName : string) : string {
	return `${getDirPath()}/${fileName}`
}

// 确保存储目录存在（首次调用时创建）
function ensureDir(fs : FileSystemManager) : void {
	try {
		fs.accessSync(getDirPath())
	} catch (e) {
		// 目录不存在，创建它
		fs.mkdirSync(getDirPath(), true)
	}
}

export function load(fileName : string) : string | null {
	const fs = uni.getFileSystemManager()
	try {
		return fs.readFileSync(getFilePath(fileName), 'utf-8') as string
	} catch (e) {
		// 文件不存在或读取失败
		return null
	}
}

export function save(fileName : string, content : string) : void {
	const fs = uni.getFileSystemManager()
	ensureDir(fs)
	// writeFileSync 在文件不存在时会自动创建
	fs.writeFileSync(getFilePath(fileName), content, 'utf-8')
}

export function clear(fileName : string) : void {
	const fs = uni.getFileSystemManager()
	try {
		fs.unlinkSync(getFilePath(fileName))
	} catch (e) {
		// 文件本来就不存在，忽略
	}
}