// ============================================================
// aws-s3-api - iOS 平台完整实现
// 通过 Swift 混编调用 AWS SDK for iOS
// ============================================================

import {
	S3Config,
	S3UploadOptions,
	S3DownloadOptions,
	S3DeleteOptions,
	S3ListOptions,
	S3ListResult,
	S3Result,
	S3PresignedUrlOptions
} from '../interface.uts'

// ============================================================
// 全局状态
// ============================================================
let s3Config : S3Config | null = null

// ============================================================
// 初始化
// ============================================================
export function initS3(config : S3Config) : void {
	s3Config = config

	NativeS3.initS3(
		config.accessKey,
		config.secretKey,
		config.sessionToken ?? null,
		config.region,
		config.endpoint ?? null
	)
}

// ============================================================
// 上传文件
// ============================================================
export function uploadFile(options : S3UploadOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: "请先调用 initS3 初始化", data: null })
			return
		}

		NativeS3.uploadFile(
			options.filePath,
			s3Config!.bucket,
			options.s3Key,
			options.contentType ?? null,
			(success : boolean, message : string) => {
				resolve({
					success: success,
					message: message,
					data: null
				})
			}
		)
	})
}

// ============================================================
// 下载文件
// ============================================================
export function downloadFile(options : S3DownloadOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: "请先调用 initS3 初始化", data: null })
			return
		}

		NativeS3.downloadFile(
			s3Config!.bucket,
			options.s3Key,
			options.savePath,
			(success : boolean, message : string) => {
				const data : UTSJSONObject = { savePath: options.savePath }
				resolve({
					success: success,
					message: message,
					data: success ? data : null
				})
			}
		)
	})
}

// ============================================================
// 删除对象
// ============================================================
export function deleteObject(options : S3DeleteOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: "请先调用 initS3 初始化", data: null })
			return
		}

		NativeS3.deleteObject(
			s3Config!.bucket,
			options.s3Key,
			(success : boolean, message : string) => {
				resolve({
					success: success,
					message: message,
					data: null
				})
			}
		)
	})
}

// ============================================================
// 列举对象
// ============================================================
export function listObjects(options : S3ListOptions) : Promise<S3ListResult> {
	return new Promise<S3ListResult>((resolve) => {
		if (s3Config == null) {
			resolve({
				success: false,
				message: "请先调用 initS3 初始化",
				keys: [],
				commonPrefixes: [],
				isTruncated: false
			})
			return
		}

		NativeS3.listObjects(
			s3Config!.bucket,
			options.prefix ?? null,
			options.delimiter ?? null,
			options.maxKeys ?? 1000,
			options.continuationToken ?? null,
			(keys : string[], prefixes : string[], isTruncated : boolean, nextToken : string | null, message : string) => {
				const result : S3ListResult = {
					success: message == "列举成功",
					message: message,
					keys: keys,
					commonPrefixes: prefixes,
					isTruncated: isTruncated
				}
				if (nextToken != null && nextToken.length > 0) {
					result.nextContinuationToken = nextToken
				}
				resolve(result)
			}
		)
	})
}

// ============================================================
// 生成预签名 URL
// ============================================================
export function getPresignedUrl(
	options : S3PresignedUrlOptions
) : Promise<string> {
	return new Promise<string>((resolve) => {
		if (s3Config == null) {
			resolve("")
			return
		}

		NativeS3.getPresignedUrl(
			s3Config!.bucket,
			options.s3Key,
			options.expiresIn ?? 3600,
			options.method ?? "get",
			(url : string) => {
				resolve(url)
			}
		)
	})
}

// ============================================================
// 获取对象公开 URL（不含签名）
// ============================================================
export function getObjectUrl(s3Key : string) : string {
	if (s3Config == null) return ""
	const cfg = s3Config!

	if (cfg.endpoint != null && cfg.endpoint!.length > 0) {
		let ep = cfg.endpoint!
		if (ep.endsWith("/")) {
			ep = ep.substring(0, ep.length - 1)
		}
		return ep + "/" + cfg.bucket + "/" + s3Key
	}

	return "https://" + cfg.bucket + ".s3." + cfg.region + ".amazonaws.com/" + s3Key
}