// ============================================================
// aws-s3-api - HarmonyOS 平台完整实现
// 通过 ArkTS 桥接调用 @ohos/aws-sdk-client-s3
// ============================================================

import {
	S3Config, S3UploadOptions, S3DownloadOptions, S3DeleteOptions,
	S3ListOptions, S3ListResult, S3Result, S3PresignedUrlOptions
} from '../interface.uts'

// ============================================================
// 全局状态
// ============================================================
let s3Config : S3Config | null = null

// ============================================================
// 初始化
// ============================================================
export function initS3(config : S3Config) : void {
	s3Config = config

	NativeS3.initS3(
		config.accessKey,
		config.secretKey,
		config.region,
		config.bucket,
		config.endpoint ?? '',
		config.sessionToken ?? ''
	)
}

// ============================================================
// 上传文件
// ============================================================
export function uploadFile(options : S3UploadOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: '请先调用 initS3 初始化', data: null })
			return
		}

		NativeS3.uploadFile(
			options.filePath,
			options.s3Key,
			options.contentType ?? ''
		).then((message : string) => {
			resolve({ success: true, message: message, data: null })
		}).catch((e : Error) => {
			resolve({ success: false, message: '上传失败: ' + e.message, data: null })
		})
	})
}

// ============================================================
// 下载文件
// ============================================================
export function downloadFile(options : S3DownloadOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: '请先调用 initS3 初始化', data: null })
			return
		}

		NativeS3.downloadFile(options.s3Key, options.savePath)
			.then((message : string) => {
				const data : UTSJSONObject = { savePath: options.savePath }
				resolve({ success: true, message: message, data: data })
			})
			.catch((e : Error) => {
				resolve({ success: false, message: '下载失败: ' + e.message, data: null })
			})
	})
}

// ============================================================
// 删除对象
// ============================================================
export function deleteObject(options : S3DeleteOptions) : Promise<S3Result> {
	return new Promise<S3Result>((resolve) => {
		if (s3Config == null) {
			resolve({ success: false, message: '请先调用 initS3 初始化', data: null })
			return
		}

		NativeS3.deleteObject(options.s3Key)
			.then((message : string) => {
				resolve({ success: true, message: message, data: null })
			})
			.catch((e : Error) => {
				resolve({ success: false, message: '删除失败: ' + e.message, data: null })
			})
	})
}

// ============================================================
// 列举对象
// ============================================================
export function listObjects(options : S3ListOptions) : Promise<S3ListResult> {
	return new Promise<S3ListResult>((resolve) => {
		if (s3Config == null) {
			resolve({
				success: false, message: '请先调用 initS3 初始化',
				keys: [], commonPrefixes: [], isTruncated: false
			})
			return
		}

		NativeS3.listObjects(
			options.prefix ?? '',
			options.delimiter ?? '',
			options.maxKeys ?? 1000,
			options.continuationToken ?? ''
		).then((result : NativeS3.ListResult) => {
			const listResult : S3ListResult = {
				success: true,
				message: '列举成功',
				keys: result.keys,
				commonPrefixes: result.commonPrefixes,
				isTruncated: result.isTruncated
			}
			if (result.nextContinuationToken != null && result.nextContinuationToken.length > 0) {
				listResult.nextContinuationToken = result.nextContinuationToken
			}
			resolve(listResult)
		}).catch((e : Error) => {
			resolve({
				success: false, message: '列举失败: ' + e.message,
				keys: [], commonPrefixes: [], isTruncated: false
			})
		})
	})
}

// ============================================================
// 生成预签名 URL
// ============================================================
export function getPresignedUrl(
	options : S3PresignedUrlOptions
) : Promise<string> {
	return new Promise<string>((resolve) => {
		if (s3Config == null) {
			resolve('')
			return
		}

		NativeS3.getPresignedUrl(
			options.s3Key,
			options.expiresIn ?? 3600,
			options.method ?? 'get'
		).then((url : string) => {
			resolve(url)
		}).catch(() => {
			resolve('')
		})
	})
}

// ============================================================
// 获取对象公开 URL（不含签名）
// ============================================================
export function getObjectUrl(s3Key : string) : string {
	if (s3Config == null) return ''
	const cfg = s3Config

	if (cfg.endpoint != null && cfg.endpoint!.length > 0) {
		let ep = cfg.endpoint!
		if (ep.endsWith('/')) {
			ep = ep.substring(0, ep.length - 1)
		}
		return ep + '/' + cfg.bucket + '/' + s3Key
	}

	return 'https://' + cfg.bucket + '.s3.' + cfg.region + '.amazonaws.com/' + s3Key
}