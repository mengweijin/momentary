// ============================================================
// aws-s3-api 统一接口声明
// 使用 export declare function 直接声明函数签名
// 各平台 index.uts 必须导出同名同签名的函数实现
// ============================================================

// ============================================================
// 一、类型定义
// ============================================================

/** S3 初始化配置 */
export type S3Config = {
	/** 自定义 Endpoint，兼容 MinIO 等 S3 兼容服务，可选 */
	endpoint ?: string
	/** AWS Access Key ID */
	accessKey : string
	/** AWS Secret Access Key */
	secretKey : string
	/** 存储桶名称 */
	bucket : string
	/** AWS 区域，如 us-east-1 */
	region : string
	/** 临时凭证 Session Token，使用 STS 时必填，可选 */
	sessionToken ?: string
}

/** 上传文件参数 */
export type S3UploadOptions = {
	/** 本地文件路径或 Blob URL */
	filePath : string
	/** S3 对象 Key（远端路径） */
	s3Key : string
	/** MIME 类型，可选 */
	contentType ?: string
}

/** 下载文件参数 */
export type S3DownloadOptions = {
	/** S3 对象 Key */
	s3Key : string
	/** 本地保存路径或下载文件名 */
	savePath : string
}

/** 删除对象参数 */
export type S3DeleteOptions = {
	/** S3 对象 Key */
	s3Key : string
}

/** 列举对象参数 */
export type S3ListOptions = {
	/** 前缀过滤，可选 */
	prefix ?: string
	/** 最大返回数量，默认 1000，可选 */
	maxKeys ?: number
	/** 分隔符，通常为 "/"，可选 */
	delimiter ?: string
	/** 分页续传 Token，可选 */
	continuationToken ?: string
}

/** 列举对象返回结果 */
export type S3ListResult = {
	/** 操作是否成功 */
	success : boolean
	/** 提示信息 */
	message : string
	/** 对象 Key 列表 */
	keys : string[]
	/** 公共前缀列表（“目录”） */
	commonPrefixes : string[]
	/** 是否被截断 */
	isTruncated : boolean
	/** 下一页 Token，可选 */
	nextContinuationToken ?: string
}

/** 通用操作返回结果 */
export type S3Result = {
	/** 操作是否成功 */
	success : boolean
	/** 提示信息 */
	message : string
	/** 附加数据，可选 */
	data ?: UTSJSONObject | null
}

/** 生成预签名 URL 参数 */
export type S3PresignedUrlOptions = {
	/** S3 对象 Key */
	s3Key : string
	/** URL 有效期（秒），默认 3600，可选 */
	expiresIn ?: number
	/** HTTP 方法，"get" 或 "put"，默认 "get"，可选 */
	method ?: string
}

// ============================================================
// 二、函数声明（各平台必须导出同名同签名的实现）
// ============================================================

/**
 * 初始化 S3 配置（必须最先调用）
 * @param config S3 配置对象
 */
export declare function initS3(config : S3Config) : void

/**
 * 上传文件到 S3
 * @param options 上传参数
 */
export declare function uploadFile(options : S3UploadOptions) : Promise<S3Result>

/**
 * 从 S3 下载文件
 * @param options 下载参数
 */
export declare function downloadFile(options : S3DownloadOptions) : Promise<S3Result>

/**
 * 删除 S3 对象
 * @param options 删除参数
 */
export declare function deleteObject(options : S3DeleteOptions) : Promise<S3Result>

/**
 * 列举 S3 对象（ListObjectsV2）
 * @param options 列举参数
 */
export declare function listObjects(options : S3ListOptions) : Promise<S3ListResult>

/**
 * 生成预签名 URL（推荐生产环境使用，避免暴露长期密钥）
 * @param options 预签名参数
 */
export declare function getPresignedUrl(
	options : S3PresignedUrlOptions
) : Promise<string>

/**
 * 获取对象公开访问 URL（不含签名，仅适用于公开桶）
 * @param s3Key S3 对象 Key
 */
export declare function getObjectUrl(s3Key : string) : string