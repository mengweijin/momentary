// ============================================================
// aws-s3-api - Web 平台完整实现
// 基于 AWS SDK for JavaScript v3
// ============================================================

import {
	S3Config,
	S3UploadOptions,
	S3DownloadOptions,
	S3DeleteOptions,
	S3ListOptions,
	S3ListResult,
	S3Result,
	S3PresignedUrlOptions
} from '../interface.uts'

// ---------- AWS SDK for JavaScript v3 ----------
import { S3Client } from '@aws-sdk/client-s3'
import {
	PutObjectCommand,
	GetObjectCommand,
	DeleteObjectCommand,
	ListObjectsV2Command
} from '@aws-sdk/client-s3'
import { getSignedUrl } from '@aws-sdk/s3-request-presigner'

// ============================================================
// 全局状态
// ============================================================
let s3Client : S3Client | null = null
let s3Config : S3Config | null = null

// ============================================================
// 初始化
// ============================================================
export function initS3(config : S3Config) : void {
	s3Config = config

	const clientOptions : any = {
		region: config.region
	}

	// 显式配置凭证
	if (config.accessKey && config.secretKey) {
		const credentials : any = {
			accessKeyId: config.accessKey,
			secretAccessKey: config.secretKey
		}
		if (config.sessionToken) {
			credentials.sessionToken = config.sessionToken
		}
		clientOptions.credentials = credentials
	}

	// 自定义 endpoint（MinIO 等需开启 path-style）
	if (config.endpoint && config.endpoint.length > 0) {
		clientOptions.endpoint = config.endpoint
		clientOptions.forcePathStyle = true
	}

	s3Client = new S3Client(clientOptions)
}

// ============================================================
// 上传文件（PutObject）
// ============================================================
export async function uploadFile(options : S3UploadOptions) : Promise<S3Result> {
	if (!s3Client || !s3Config) {
		return { success: false, message: '请先调用 initS3 初始化', data: null }
	}

	try {
		// Web 端：将 filePath（Blob URL）转成 Blob
		const response = await fetch(options.filePath)
		const blob = await response.blob()

		const command = new PutObjectCommand({
			Bucket: s3Config.bucket,
			Key: options.s3Key,
			Body: blob,
			ContentType: options.contentType ?? 'application/octet-stream'
		})

		await s3Client.send(command)
		return { success: true, message: '上传成功', data: null }
	} catch (e : any) {
		return { success: false, message: '上传失败: ' + e.message, data: null }
	}
}

// ============================================================
// 下载文件（GetObject）
// ============================================================
export async function downloadFile(
	options : S3DownloadOptions
) : Promise<S3Result> {
	if (!s3Client || !s3Config) {
		return { success: false, message: '请先调用 initS3 初始化', data: null }
	}

	try {
		const command = new GetObjectCommand({
			Bucket: s3Config.bucket,
			Key: options.s3Key
		})

		const response = await s3Client.send(command)
		if (!response.Body) {
			return { success: false, message: '下载失败: 响应体为空', data: null }
		}

		// 将流转换为字节数组，再用 Blob 触发浏览器下载
		const bytes : Uint8Array = await response.Body.transformToByteArray()
		const blob = new Blob([bytes])
		const url = URL.createObjectURL(blob)

		const link = document.createElement('a')
		link.href = url
		link.download = options.savePath
		document.body.appendChild(link)
		link.click()
		document.body.removeChild(link)
		URL.revokeObjectURL(url)

		const data : UTSJSONObject = { savePath: options.savePath }
		return { success: true, message: '下载成功', data: data }
	} catch (e : any) {
		return { success: false, message: '下载失败: ' + e.message, data: null }
	}
}

// ============================================================
// 删除对象（DeleteObject）
// ============================================================
export async function deleteObject(
	options : S3DeleteOptions
) : Promise<S3Result> {
	if (!s3Client || !s3Config) {
		return { success: false, message: '请先调用 initS3 初始化', data: null }
	}

	try {
		const command = new DeleteObjectCommand({
			Bucket: s3Config.bucket,
			Key: options.s3Key
		})
		await s3Client.send(command)
		return { success: true, message: '删除成功', data: null }
	} catch (e : any) {
		return { success: false, message: '删除失败: ' + e.message, data: null }
	}
}

// ============================================================
// 列举对象（ListObjectsV2）
// ============================================================
export async function listObjects(
	options : S3ListOptions
) : Promise<S3ListResult> {
	if (!s3Client || !s3Config) {
		return {
			success: false,
			message: '请先调用 initS3 初始化',
			keys: [],
			commonPrefixes: [],
			isTruncated: false
		}
	}

	try {
		const command = new ListObjectsV2Command({
			Bucket: s3Config.bucket,
			Prefix: options.prefix,
			Delimiter: options.delimiter,
			MaxKeys: options.maxKeys ?? 1000,
			ContinuationToken: options.continuationToken
		})

		const response = await s3Client.send(command)

		const keys : string[] = []
		if (response.Contents) {
			for (let i = 0; i < response.Contents.length; i++) {
				const key = response.Contents[i].Key
				if (key) keys.push(key)
			}
		}

		const prefixes : string[] = []
		if (response.CommonPrefixes) {
			for (let i = 0; i < response.CommonPrefixes.length; i++) {
				const p = response.CommonPrefixes[i].Prefix
				if (p) prefixes.push(p)
			}
		}

		const result : S3ListResult = {
			success: true,
			message: '列举成功',
			keys: keys,
			commonPrefixes: prefixes,
			isTruncated: response.IsTruncated ?? false
		}

		if (response.NextContinuationToken) {
			result.nextContinuationToken = response.NextContinuationToken
		}

		return result
	} catch (e : any) {
		return {
			success: false,
			message: '列举失败: ' + e.message,
			keys: [],
			commonPrefixes: [],
			isTruncated: false
		}
	}
}

// ============================================================
// 生成预签名 URL
// ============================================================
export async function getPresignedUrl(
	options : S3PresignedUrlOptions
) : Promise<string> {
	if (!s3Client || !s3Config) {
		return ''
	}

	try {
		const method = (options.method ?? 'get').toLowerCase()
		const expiresIn = options.expiresIn ?? 3600

		let command : any
		if (method === 'put') {
			command = new PutObjectCommand({
				Bucket: s3Config.bucket,
				Key: options.s3Key
			})
		} else {
			command = new GetObjectCommand({
				Bucket: s3Config.bucket,
				Key: options.s3Key
			})
		}

		return await getSignedUrl(s3Client, command, { expiresIn: expiresIn })
	} catch (e : any) {
		return ''
	}
}

// ============================================================
// 获取对象公开 URL（不含签名）
// ============================================================
export function getObjectUrl(s3Key : string) : string {
	if (!s3Config) return ''
	const cfg = s3Config

	if (cfg.endpoint && cfg.endpoint.length > 0) {
		let ep = cfg.endpoint
		if (ep.endsWith('/')) {
			ep = ep.substring(0, ep.length - 1)
		}
		return ep + '/' + cfg.bucket + '/' + s3Key
	}

	return `https://${cfg.bucket}.s3.${cfg.region}.amazonaws.com/${s3Key}`
}
