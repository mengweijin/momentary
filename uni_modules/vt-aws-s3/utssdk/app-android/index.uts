// ============================================================
// aws-s3-api - Android 平台完整实现
// 基于 AWS SDK for Android (com.amazonaws:aws-android-sdk-s3)
// ============================================================

import {
	S3Config,
	S3UploadOptions,
	S3DownloadOptions,
	S3DeleteOptions,
	S3ListOptions,
	S3ListResult,
	S3Result,
	S3PresignedUrlOptions
} from '../interface.uts'

// ---------- AWS SDK for Android ----------
import { AmazonS3Client } from 'com.amazonaws.services.s3.AmazonS3Client'
import { BasicAWSCredentials } from 'com.amazonaws.auth.BasicAWSCredentials'
import { BasicSessionCredentials } from 'com.amazonaws.auth.BasicSessionCredentials'
import { PutObjectRequest } from 'com.amazonaws.services.s3.model.PutObjectRequest'
import { GetObjectRequest } from 'com.amazonaws.services.s3.model.GetObjectRequest'
import { DeleteObjectRequest } from 'com.amazonaws.services.s3.model.DeleteObjectRequest'
import { ListObjectsV2Request } from 'com.amazonaws.services.s3.model.ListObjectsV2Request'
import { ListObjectsV2Result } from 'com.amazonaws.services.s3.model.ListObjectsV2Result'
import { ObjectMetadata } from 'com.amazonaws.services.s3.model.ObjectMetadata'
import { S3Object } from 'com.amazonaws.services.s3.model.S3Object'
import { S3ObjectSummary } from 'com.amazonaws.services.s3.model.S3ObjectSummary'
import { GeneratePresignedUrlRequest } from 'com.amazonaws.services.s3.model.GeneratePresignedUrlRequest'
import { HttpMethod } from 'com.amazonaws.http.HttpMethodName'
import { ClientConfiguration } from 'com.amazonaws.ClientConfiguration'
import { Region } from 'com.amazonaws.regions.Region'
import { Regions } from 'com.amazonaws.regions.Regions'

// ---------- Android 原生导入 ----------
import { File } from 'java.io'
import { FileInputStream } from 'java.io'
import { FileOutputStream } from 'java.io'
import { BufferedOutputStream } from 'java.io'
import { ByteArrayOutputStream } from 'java.io'
import { UTSAndroid } from 'io.dcloud.uts'

// ============================================================
// 全局状态
// ============================================================
let s3Client : AmazonS3Client | null = null
let s3Config : S3Config | null = null

// ============================================================
// 子线程执行包装
// ============================================================
function runInBackground<T>(task : () => T) : Promise<T> {
	return new Promise<T>((resolve, reject) => {
		UTSAndroid.getDispatcher().dispatch(() => {
			try {
				resolve(task())
			} catch (e : any) {
				reject(e)
			}
		})
	})
}

// ============================================================
// 初始化
// ============================================================
export function initS3(config : S3Config) : void {
	s3Config = config

	// 构造凭证
	let credentials : any
	if (config.sessionToken != null && config.sessionToken!.length > 0) {
		credentials = new BasicSessionCredentials(
			config.accessKey,
			config.secretKey,
			config.sessionToken!
		)
	} else {
		credentials = new BasicAWSCredentials(config.accessKey, config.secretKey)
	}

	// 客户端配置
	const clientConfig = new ClientConfiguration()
	clientConfig.setMaxErrorRetry(3)
	clientConfig.setConnectionTimeout(30000)
	clientConfig.setSocketTimeout(60000)

	// 创建 S3 客户端
	s3Client = new AmazonS3Client(credentials, clientConfig)

	// 设置区域
	const regionName = config.region.replace("-", "_").toUpperCase()
	const regions = Regions.fromName(regionName)
	s3Client!.setRegion(Region.getRegion(regions))

	// 自定义 Endpoint（兼容 MinIO 等）
	if (config.endpoint != null && config.endpoint!.length > 0) {
		s3Client!.setEndpoint(config.endpoint!)
	}
}

// ============================================================
// 上传文件（PutObject）
// ============================================================
export function uploadFile(options : S3UploadOptions) : Promise<S3Result> {
	return runInBackground<S3Result>(() : S3Result => {
		if (s3Client == null || s3Config == null) {
			return { success: false, message: "请先调用 initS3 初始化", data: null }
		}

		try {
			const file = new File(options.filePath)
			if (!file.exists()) {
				return { success: false, message: "文件不存在: " + options.filePath, data: null }
			}

			// 构造对象元数据
			const metadata = new ObjectMetadata()
			metadata.setContentLength(file.length())
			if (options.contentType != null && options.contentType!.length > 0) {
				metadata.setContentType(options.contentType!)
			}

			// 构造上传请求
			const inputStream = new FileInputStream(file)
			const putRequest = new PutObjectRequest(
				s3Config!.bucket,
				options.s3Key,
				inputStream,
				metadata
			)

			// 执行上传
			s3Client!.putObject(putRequest)
			inputStream.close()

			return { success: true, message: "上传成功", data: null }
		} catch (e : any) {
			return { success: false, message: "上传失败: " + e.message, data: null }
		}
	})
}

// ============================================================
// 下载文件（GetObject）
// ============================================================
export function downloadFile(options : S3DownloadOptions) : Promise<S3Result> {
	return runInBackground<S3Result>(() : S3Result => {
		if (s3Client == null || s3Config == null) {
			return { success: false, message: "请先调用 initS3 初始化", data: null }
		}

		try {
			const getRequest = new GetObjectRequest(s3Config!.bucket, options.s3Key)
			const s3Object : S3Object = s3Client!.getObject(getRequest)

			// 将对象内容写入本地文件
			const inputStream = s3Object.getObjectContent()
			const outputStream = new FileOutputStream(options.savePath)
			const buffer = new ByteArray(8192)
			let bytesRead = inputStream.read(buffer)
			while (bytesRead > 0) {
				outputStream.write(buffer, 0, bytesRead)
				bytesRead = inputStream.read(buffer)
			}
			outputStream.flush()
			outputStream.close()
			inputStream.close()

			const data : UTSJSONObject = { savePath: options.savePath }
			return { success: true, message: "下载成功", data: data }
		} catch (e : any) {
			return { success: false, message: "下载失败: " + e.message, data: null }
		}
	})
}

// ============================================================
// 删除对象（DeleteObject）
// ============================================================
export function deleteObject(options : S3DeleteOptions) : Promise<S3Result> {
	return runInBackground<S3Result>(() : S3Result => {
		if (s3Client == null || s3Config == null) {
			return { success: false, message: "请先调用 initS3 初始化", data: null }
		}

		try {
			s3Client!.deleteObject(new DeleteObjectRequest(s3Config!.bucket, options.s3Key))
			return { success: true, message: "删除成功", data: null }
		} catch (e : any) {
			return { success: false, message: "删除失败: " + e.message, data: null }
		}
	})
}

// ============================================================
// 列举对象（ListObjectsV2）
// ============================================================
export function listObjects(options : S3ListOptions) : Promise<S3ListResult> {
	return runInBackground<S3ListResult>(() : S3ListResult => {
		if (s3Client == null || s3Config == null) {
			return {
				success: false,
				message: "请先调用 initS3 初始化",
				keys: [],
				commonPrefixes: [],
				isTruncated: false
			}
		}

		try {
			const request = new ListObjectsV2Request()
			request.setBucketName(s3Config!.bucket)
			if (options.prefix != null && options.prefix!.length > 0) {
				request.setPrefix(options.prefix!)
			}
			if (options.delimiter != null && options.delimiter!.length > 0) {
				request.setDelimiter(options.delimiter!)
			}
			request.setMaxKeys(options.maxKeys ?? 1000)
			if (options.continuationToken != null && options.continuationToken!.length > 0) {
				request.setContinuationToken(options.continuationToken!)
			}

			const result : ListObjectsV2Result = s3Client!.listObjectsV2(request)

			// 提取对象 Key 列表
			const keys : string[] = []
			const summaries = result.getObjectSummaries()
			for (let i = 0; i < summaries.size(); i++) {
				const summary = summaries.get(i) as S3ObjectSummary
				keys.push(summary.getKey())
			}

			// 提取公共前缀（目录）
			const prefixes : string[] = []
			const commonPrefixes = result.getCommonPrefixes()
			for (let i = 0; i < commonPrefixes.size(); i++) {
				prefixes.push(commonPrefixes.get(i))
			}

			const listResult : S3ListResult = {
				success: true,
				message: "列举成功",
				keys: keys,
				commonPrefixes: prefixes,
				isTruncated: result.isTruncated()
			}

			const nextToken = result.getNextContinuationToken()
			if (nextToken != null && nextToken.length > 0) {
				listResult.nextContinuationToken = nextToken
			}

			return listResult
		} catch (e : any) {
			return {
				success: false,
				message: "列举失败: " + e.message,
				keys: [],
				commonPrefixes: [],
				isTruncated: false
			}
		}
	})
}

// ============================================================
// 生成预签名 URL
// ============================================================
export function getPresignedUrl(
	options : S3PresignedUrlOptions
) : Promise<string> {
	return runInBackground<string>(() : string => {
		if (s3Client == null || s3Config == null) {
			return ""
		}

		try {
			const method = (options.method ?? "get").toLowerCase()
			const httpMethod = method == "put" ? HttpMethod.PUT : HttpMethod.GET

			const request = new GeneratePresignedUrlRequest(s3Config!.bucket, options.s3Key)
			request.setMethod(httpMethod)

			const expiresIn = options.expiresIn ?? 3600
			const expiration = new Date()
			expiration.setTime(expiration.getTime() + expiresIn * 1000)
			request.setExpiration(expiration)

			const url = s3Client!.generatePresignedUrl(request)
			return url.toString()
		} catch (e : any) {
			return ""
		}
	})
}

// ============================================================
// 获取对象公开 URL（不含签名）
// ============================================================
export function getObjectUrl(s3Key : string) : string {
	if (s3Config == null) return ""
	const cfg = s3Config!

	if (cfg.endpoint != null && cfg.endpoint!.length > 0) {
		let ep = cfg.endpoint!
		if (ep.endsWith("/")) {
			ep = ep.substring(0, ep.length - 1)
		}
		return ep + "/" + cfg.bucket + "/" + s3Key
	}

	return "https://" + cfg.bucket + ".s3." + cfg.region + ".amazonaws.com/" + s3Key
}
