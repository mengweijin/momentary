// ============================================================
// vt-s3 统一接口声明
// 使用 export declare function 直接声明函数签名
// 各平台 index.uts 必须导出同名同签名的函数实现
// ============================================================

// ============================================================
// 一、类型定义
// ============================================================

/** S3 初始化配置 */
export type S3Config = {
	/** MinIO / RustFS 服务地址，必须包含 http:// 或 https:// */
	endpoint : string
	/** AWS Access Key ID */
	accessKey : string
	/** AWS Secret Access Key */
	secretKey : string
	/** 存储桶名称 */
	bucket : string
	/** AWS 区域，如：cn-north-1、us-east-1 */
	region : string
	/** 是否使用 path-style URL（MinIO / RustFS 通常设为 true） */
	forcePathStyle : boolean
}

// ============================================================
// 二、函数声明（各平台必须导出同名同签名的实现）
// ============================================================

/**
 * 初始化 S3 配置（必须最先调用）
 * @param config S3 配置对象
 */
export declare function initS3(config : S3Config) : Promise<UTSJSONObject>

/**
 * 检查初始化配置中指定的 bucket 是否存在
 */
export declare function bucketExists() : Promise<boolean>

/**
 * 创建初始化配置中指定的 bucket
 */
export declare function createBucket() : Promise<UTSJSONObject>

/**
 * 列举 S3 对象（ListObjectsV2）
 * @param prefix 对象键前缀；传 null 时列举所有对象
 */
export declare function listObjects(prefix : string | null) : Promise<UTSJSONObject>

/**
 * 获取 S3 对象
 * @param key MinIO 中的对象 path
 */
export declare function getObject(key : string) : Promise<UTSJSONObject>

/**
 * 删除 S3 对象
 * @param key MinIO 中的对象 path
 */
export declare function deleteObject(key : string) : Promise<UTSJSONObject>
