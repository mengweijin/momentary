<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<rice-form :model="form" ref="formRef" label-width="120px" class="mo-oss-form">
			<rice-form-item name="endpoint" label="S3 地址：" required>
				<rice-input v-model="form.s3.endpoint" clearable placeholder="例如：https://127.0.0.1:9000"
					border="none" />
			</rice-form-item>
			<rice-form-item name="accessKey" label="Access Key：" required>
				<rice-input v-model="form.s3.accessKey" clearable placeholder="请输入 Access Key" border="none" />
			</rice-form-item>
			<rice-form-item name="secretKey" label="Secret Key：" required>
				<rice-input v-model="form.s3.secretKey" clearable placeholder="请输入 Secret Key" border="none"
					type="password" />
			</rice-form-item>
			<rice-form-item name="bucket" label="Bucket：" required>
				<rice-input v-model="form.s3.bucket" clearable placeholder="请输入 Bucket" border="none" />
			</rice-form-item>
			<rice-form-item name="region" label="Region：" required>
				<rice-input v-model="form.s3.region" clearable placeholder="请输入 Region" border="none" />
			</rice-form-item>

			<rice-form-item name="photo" label="照片路径：">
				<rice-input v-model="form.path.photo" clearable placeholder="例如：/photo" border="none">
					<template #suffix>
						<rice-icon name="info" size="18px" color="blue" :custom-style="{'margin-left':'10px'}"
							@click="showToast(`全路径：${form.s3.endpoint}/${form.s3.bucket}/${form.path.photo}`)">
						</rice-icon>
					</template>
				</rice-input>
			</rice-form-item>
			<rice-form-item name="music" label="音乐路径：">
				<rice-input v-model="form.path.music" clearable placeholder="例如：/music" border="none">
					<template #suffix>
						<rice-icon name="info" size="18px" color="blue" :custom-style="{'margin-left':'10px'}"
							@click="showToast(`全路径：${form.s3.endpoint}/${form.s3.bucket}/${form.path.music}`)">
						</rice-icon>
					</template>
				</rice-input>
			</rice-form-item>
			<rice-form-item name="video" label="视频路径：">
				<rice-input v-model="form.path.video" clearable placeholder="例如：/video" border="none">
					<template #suffix>
						<rice-icon name="info" size="18px" color="blue" :custom-style="{'margin-left':'10px'}"
							@click="showToast(`全路径：${form.s3.endpoint}/${form.s3.bucket}/${form.path.video}`)">
						</rice-icon>
					</template>
				</rice-input>
			</rice-form-item>
		</rice-form>
		<view class="mom-oss-button-view">
			<rice-button v-if="false" type="primary" text="保 存" class="mom-oss-button" shape="round" @click="submit" />
			<rice-button type="warning" text="重 置" class="mom-oss-button" shape="round" @click="reset" />
		</view>

		<rice-dialog v-model:show="showResetConfirm" message="重置将丢失已配置信息，确认重置吗？" @confirm="resetOssConfig()" />

		<nax-toast />
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup>
	import { type OssConfig, ossData as form, resetOssConfig } from "@/storage/oss-storage.uts"
	import { naxToast as showNaxToast } from '@/uni_modules/nax-toast/index.uts'
	import { init, ossData } from '@/storage/oss-storage.uts';

	const formRef = ref<RiceFormComponentPublicInstance | null>(null);

	const submit = async () => {
		formRef.value!.clearAllValidate();
		const result = await formRef.value!.validate();
		if (result) {
			//校验成功
		}
	}

	const showResetConfirm = ref<boolean>(false);
	const reset = () => {
		showResetConfirm.value = true;
	}

	const showToast = (title : string) => {
		showNaxToast({ title: title, showIcon: false, type: 'info', duration: 3000, position: 'top' })
	}
	
	onUnload(async () => {
		// 退出该页面时强制重新初始化 s3 对象
		await init(true);
	});
</script>

<style lang="scss">
	.mo-oss-form {
		padding: 0 20px;
