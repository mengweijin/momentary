<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex: 1; min-height: 0">
	<!-- #endif -->
		<view class="mo-index-page">
			<view class="mo-index-header">
				<view class="mo-index-brand">
					<rice-image width="56" height="56" src="/static/images/png/logo.png" radius="14px" />
					<view class="mo-index-brand-text">
						<text class="mo-index-title">时光盒</text>
						<text class="mo-index-subtitle">把美好，收进日常</text>
					</view>
				</view>
				<text class="mo-index-greeting">欢迎回来</text>
				<text class="mo-index-description">你的私人影音空间，随时回味每一刻。</text>
			</view>

			<view class="mo-index-section-heading">
				<view>
					<text class="mo-index-section-title">我的媒体库</text>
					<text class="mo-index-section-caption">珍藏的内容一目了然</text>
				</view>
				<text class="mo-index-refresh" @click="loadStats">{{ isLoading ? '加载中' : '刷新' }}</text>
			</view>

			<view class="mo-index-stats">
				<view class="mo-index-stat-card mo-index-photo" @click="openTab('/pages/photo/photo')">
					<view class="mo-index-icon mo-index-photo-icon">
						<rice-icon name="photo" size="22px" color="#4388f5" />
					</view>
					<text class="mo-index-count">{{ photoCount }}</text>
					<text class="mo-index-stat-label">照片</text>
					<text class="mo-index-stat-link">去看看 ›</text>
				</view>
				<view class="mo-index-stat-card mo-index-music" @click="openTab('/pages/music/music')">
					<view class="mo-index-icon mo-index-music-icon">
						<rice-icon name="volume-fill" size="22px" color="#9b70e8" />
					</view>
					<text class="mo-index-count">{{ musicCount }}</text>
					<text class="mo-index-stat-label">音乐</text>
					<text class="mo-index-stat-link">去听听 ›</text>
				</view>
				<view class="mo-index-stat-card mo-index-video" @click="openTab('/pages/video/video')">
					<view class="mo-index-icon mo-index-video-icon">
						<rice-icon name="play" size="22px" color="#f18b55" />
					</view>
					<text class="mo-index-count">{{ videoCount }}</text>
					<text class="mo-index-stat-label">视频</text>
					<text class="mo-index-stat-link">去看看 ›</text>
				</view>
			</view>

			<text v-if="statsError.length > 0" class="mo-index-error">{{ statsError }}</text>
			<text v-else class="mo-index-footnote">数量根据 OSS 中对应目录的文件实时统计</text>

			<view class="mo-index-storage">
				<view class="mo-index-storage-icon">
					<text class="mo-index-storage-mark">S3</text>
				</view>
				<view class="mo-index-storage-info">
					<text class="mo-index-storage-label">当前存储空间</text>
					<text class="mo-index-storage-bucket">{{ ossData.s3.bucket }}</text>
				</view>
				<text class="mo-index-storage-status">{{ isLoading ? '同步中' : 'OSS' }}</text>
			</view>

			<view class="mo-index-tip">
				<text class="mo-index-tip-title">记录每一段值得珍藏的时光</text>
				<text class="mo-index-tip-content">照片、音乐与视频，汇聚在你的专属时光盒里。</text>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
	<mo-tabbar currentName="index" style="flex: 0 0 auto; justify-content: flex-end" />
</template>

<script setup>
	import { ref } from 'vue';
	import { init, isInited, ossData } from '@/storage/oss-storage.uts';
	import { listObjects } from '@/uni_modules/vt-s3-api';

	const photoCount = ref<string>('—');
	const musicCount = ref<string>('—');
	const videoCount = ref<string>('—');
	const isLoading = ref<boolean>(false);
	const statsError = ref<string>('');

	const getCount = (result: UTSJSONObject): string => {
		const count = result.count;
		if (count == null) {
			throw new Error('OSS 返回的文件数量无效。');
		}
		return count.toString();
	};

	const loadStats = async () => {
		if (isLoading.value) return;
		isLoading.value = true;
		statsError.value = '';
		try {
			await init();
			if (!isInited.value) {
				throw new Error('OSS 初始化失败。');
			}
			const results = await Promise.all([
				listObjects(ossData.value.path.photo),
				listObjects(ossData.value.path.music),
				listObjects(ossData.value.path.video)
			]);
			photoCount.value = getCount(results[0]);
			musicCount.value = getCount(results[1]);
			videoCount.value = getCount(results[2]);
		} catch (error) {
			console.error('Failed to load OSS media counts.', error);
			photoCount.value = '—';
			musicCount.value = '—';
			videoCount.value = '—';
			statsError.value = '暂时无法读取媒体数量，请检查 OSS 配置或网络后重试。';
		} finally {
			isLoading.value = false;
		}
	};

	const openTab = (url: string) => {
		uni.switchTab({ url });
	};

	onShow(() => {
		loadStats();
	});
</script>

