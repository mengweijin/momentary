<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex:1">
	<!-- #endif -->
		<rice-cell-group border title="配置">
			<rice-cell title="OSS(S3)" value="S3 配置" :label="ossEndpoint" arrow center url="/pages/oss/oss">
				<template #leftIcon>
					<rice-icon font-family="icon-momentary" name="e60c" size="36" color="blue"
						style="margin-right: 5px;"></rice-icon>
				</template>
			</rice-cell>
		</rice-cell-group>

		<rice-cell-group border title="关于">
			<rice-cell title="软件名称" :value="appName" center>
				<template #rightIcon>
					<rice-image width="30" height="30" src="/static/images/png/logo.png" radius="8px" />
				</template>
			</rice-cell>
			<rice-cell title="软件协议">
				<template #rightIcon>
					<rice-text text="Apache License 2.0" decoration="underline" type="primary"
						@click="onLicenseClick" />
				</template>
			</rice-cell>
			<rice-cell title="软件版本" :value="appVersion"></rice-cell>
			<rice-cell title="代码仓库">
				<template #rightIcon>
					<rice-icon font-family="icon-momentary" name="e628" size="24" color="gray"
						@click="onGithubClick"></rice-icon>
					<rice-icon font-family="icon-momentary" name="e602" size="24" color="red" style="margin-left: 10px;"
						@click="onGiteeClick"></rice-icon>
				</template>
			</rice-cell>
		</rice-cell-group>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->

	<mo-tabbar currentName="mine" />
</template>

<script setup>
	import { ref } from 'vue';
	import { openSchema } from '@/uni_modules/uts-openSchema';
	import { ossData } from "@/store/oss-store.uts";
	
	const appName = ref('');
	const appVersion = ref('');
	
	const ossEndpoint = computed(() => {
		return ossData.value?.s3?.endpoint;
	});

	const onLicenseClick = () => {
		// #ifdef UNI-APP-X
		// 使用外部浏览器打开指定URL
		openSchema('https://github.com/mengweijin/momentary/blob/master/LICENSE')
		// #endif
	}

	const onGiteeClick = () => {
		// #ifdef UNI-APP-X
		// 使用外部浏览器打开指定URL
		openSchema('https://gitee.com/mengweijin/momentary')
		// #endif
	}

	const onGithubClick = () => {
		// #ifdef UNI-APP-X
		// 使用外部浏览器打开指定URL
		openSchema('https://github.com/mengweijin/momentary')
		// #endif
	}

	onLoad(() => {
		// 同步获取应用基础信息
		const appInfo = uni.getAppBaseInfo();
		// 用 ! 告诉编译器忽略 null 检查。否则 PC 端正常，安卓端编译报错
		appName.value = appInfo.appName!;
		appVersion.value = appInfo.appVersion!;
	});
</script>

